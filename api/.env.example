PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/recipes_db
JWT_SECRET=your_super_secret_jwt_key
ACCESS_CONTROL_ALLOW_ORIGIN=http://localhost:8888

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend Email Service
RESEND_EMAIL_API_KEY=re_your_api_key

# Cron Job Secret (for GitHub Actions / External Cron triggers)
CRON_SECRET=your_super_secret_cron_key

# Upstash Redis (View Count Buffer)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Upstash QStash (Asynchronous Email Queue & Webhook)
QSTASH_TOKEN=ey...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
QSTASH_EMAIL_QUEUE=email-queue
QSTASH_EMAIL_RETRIES=3
QSTASH_EMAIL_DELAY=0
API_BASE_URL=https://api.bepphuong.online

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id

# Facebook OAuth2
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret a

